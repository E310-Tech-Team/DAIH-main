{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "TOKEN_ENCRYPTION_KEY",
    "QR_SIGNING_SECRET",
    "PORT",
    "PAYSTACK_SECRET_KEY",
    "PAYSTACK_PUBLIC_KEY",
    "RESEND_API_KEY",
    "ZEPTOMAIL_API_KEY",
    "SENTRY_DSN",
    "DD_SERVICE",
    "DD_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "JWT_REFRESH_SECRET",
        "TOKEN_ENCRYPTION_KEY",
        "QR_SIGNING_SECRET",
        "PORT",
        "PAYSTACK_SECRET_KEY",
        "PAYSTACK_PUBLIC_KEY"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
