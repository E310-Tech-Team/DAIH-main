# ==============================================================================
# DAIH Platform - Production Hostinger VPS Environment Template (.env.example)
# ==============================================================================
# Architecture on Hostinger VPS:
# - Nginx reverse-proxies ports 80/443 (Let's Encrypt SSL) to local Node ports:
#     https://daih.ng          -> 127.0.0.1:3000 (Marketing Web)
#     https://app.daih.ng      -> 127.0.0.1:3001 (Customer PWA)
#     https://kiosk.daih.ng-> 127.0.0.1:3002 (Reception Kiosk)
#     https://admin.daih.ng    -> 127.0.0.1:3003 (Admin Portal)
#     https://api.daih.ng      -> 127.0.0.1:4000 (Backend API)
# ==============================================================================

# Node Environment & Server Port
NODE_ENV=production
PORT=4000

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Managed on Hostinger VPS via Docker or local systemd postgresql
DATABASE_URL="postgresql://postgres:YOUR_SECURE_DB_PASSWORD@localhost:5432/daih_db?schema=public"

# ─── Cache & Message Broker (Redis) ──────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Security & Authentication (JWT & Encryption) ────────────────────────────
# CRITICAL FOR PRODUCTION: Must be at least 32 characters and completely independent
# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-openssl-rand-hex-32-secret-one"
JWT_REFRESH_SECRET="replace-with-openssl-rand-hex-32-secret-two"
TOKEN_ENCRYPTION_KEY="replace-with-openssl-rand-hex-32-secret-three"
QR_SIGNING_SECRET="replace-with-openssl-rand-hex-32-qr-secret"

# Token Expiry Durations
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_REFRESH_DAYS=7
VERIFICATION_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_HOURS=1

# ─── Cookies & Cross-Subdomain Sharing ───────────────────────────────────────
# Scopes the HttpOnly refresh token cookie across all *.daih.ng subdomains
COOKIE_DOMAIN=".daih.ng"
COOKIE_PATH="/api/v1/identity"
COOKIE_SAME_SITE="lax"
COOKIE_SECURE="true"

# ─── Reverse Proxy IP Trust & Origin Security (Hostinger Nginx) ──────────────
# Trusts loopback (127.0.0.1/::1) from local Nginx and Docker bridge networks
TRUSTED_PROXIES="loopback,linklocal,uniquelocal"

# Optional shared secret verified between Nginx and Express for defense-in-depth:
# In Nginx: proxy_set_header X-Origin-Verify-Secret "your-origin-verify-secret";
ORIGIN_VERIFY_SECRET="replace-with-origin-secret-shared-with-nginx"

# Leave false in production; set to true only when verifying IP resolution as Super Admin
ENABLE_DIAGNOSTIC_IP_ENDPOINT="false"

# ─── Initial Super Administrator Seeding (pnpm run seed:admin) ───────────────
SUPER_ADMIN_EMAIL="admin@daih.ng"
SUPER_ADMIN_PASSWORD="ReplaceWithStrongAdminPassword123!"
SUPER_ADMIN_FIRST_NAME="Super"
SUPER_ADMIN_LAST_NAME="Administrator"
SUPER_ADMIN_PHONE="07042504389"

# ─── Transactional Email Providers ───────────────────────────────────────────
EMAIL_PROVIDER="auto" # Options: 'auto' | 'resend' | 'zeptomail' | 'mock'
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="DAIH Hub <noreply@daih.ng>"
ZEPTOMAIL_API_KEY=""
ZEPTOMAIL_FROM_EMAIL="DAIH Hub <noreply@daih.ng>"
ZEPTOMAIL_API_URL="https://api.zeptomail.com/v1.1/email"

# ─── Rate Limiting (Redis-backed) ────────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=15
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW=60
RATE_LIMIT_VERIFY_MAX=3
RATE_LIMIT_VERIFY_WINDOW=60
RATE_LIMIT_RESET_MAX=3
RATE_LIMIT_RESET_WINDOW=60

# ─── Frontend URLs & CORS Origins ────────────────────────────────────────────
FRONTEND_CUSTOMER_URL="https://app.daih.ng"
FRONTEND_ADMIN_URL="https://admin.daih.ng"
FRONTEND_WEB_URL="https://daih.ng"
ALLOWED_ORIGINS="https://daih.ng,https://app.daih.ng,https://admin.daih.ng,https://kiosk.daih.ng"

# ─── Next.js Rewrites & Client API Configuration ────────────────────────────
# Used by Next.js server to proxy /api/v1 requests locally to Express on the VPS
INTERNAL_API_URL="http://127.0.0.1:4000"

# Tells browser fetch clients to use the same-origin relative proxy path
NEXT_PUBLIC_API_URL="/api/v1"

# Cross-Portal Public Navigation Links
NEXT_PUBLIC_WEB_URL="https://daih.ng"
NEXT_PUBLIC_CUSTOMER_PWA_URL="https://app.daih.ng"
NEXT_PUBLIC_CUSTOMER_PORTAL_URL="https://app.daih.ng"
NEXT_PUBLIC_RECEPTION_URL="https://kiosk.daih.ng"
NEXT_PUBLIC_ADMIN_URL="https://admin.daih.ng"

# ─── Google OAuth & Sign-In (Google Identity Services) ────────────────────────
# Created in Google Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Web Application Type:
# Authorized JavaScript Origins: https://app.daih.ng, http://localhost:3001
# Note: Google ID token flow does NOT require or use a client secret.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# ─── Paystack Payment Gateway ────────────────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_live_xxx"
PAYSTACK_PUBLIC_KEY="pk_live_xxx"
# Paystack signs webhooks with PAYSTACK_SECRET_KEY; there is no separate webhook secret.
# Payments and webhooks stay disabled in production until the secret key is real.

# ─── File Storage (S3 / MinIO - Optional) ────────────────────────────────────
# File uploads (avatars, resources) are stored locally on the VPS filesystem under ./uploads
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="daih-documents"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# ─── Observability (Sentry & Datadog) ────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
DD_SERVICE="daih-api"
DD_ENV="production"
DD_VERSION="1.0.0"
