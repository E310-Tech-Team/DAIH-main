{
  "name": "daih-platform",
  "version": "1.0.0",
  "private": true,
  "description": "DAIH Workspace Platform - Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "seed:admin": "pnpm --filter @daih/api run seed:admin",
    "db:push": "pnpm --filter @daih/api run db:push",
    "prisma:generate": "pnpm --filter @daih/api run prisma:generate",
    "postinstall": "pnpm prisma:generate && pnpm --filter @daih/types build",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "overrides": {
      "htmlparser2": "^9.1.0"
    },
    "onlyBuiltDependencies": [
      "argon2",
      "prisma",
      "@prisma/client",
      "@prisma/engines"
    ]
  },
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  }
}
