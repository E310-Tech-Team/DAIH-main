datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  RECEPTION_OFFICER
  SECURITY_OFFICER
  OPERATIONS_ADMIN
  FINANCE_OFFICER
  SUPER_ADMIN
  MANAGEMENT_VIEWER
}

enum ResourceCategory {
  HOT_DESK
  FLEX_DESK
  DEDICATED_DESK
  OFFICE_SUITE
  CONFERENCE_HALL
  TRAINING_ROOM
  ROOFTOP_LOUNGE
  STUDIO
}

enum BookingState {
  DRAFT
  HELD
  PENDING_PAYMENT
  CONFIRMED
  ACTIVE
  CHECKED_IN
  CHECKED_OUT
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  ABANDONED
  EXPIRED
  FLAGGED_MISMATCH
  REQUIRES_RECONCILIATION
}

enum TransactionType {
  PAYMENT
  REFUND
}

enum PaymentMethod {
  PAYSTACK
  SUBSCRIPTION_CREDIT
  BANK_TRANSFER
  POS_TERMINAL
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

enum MfaMethod {
  EMAIL_OTP
  TOTP
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FIXED_PRICE
}

enum CustomerEligibility {
  ALL
  SPECIFIC_CUSTOMERS
  FIRST_TIME_ONLY
  DOMAIN_MATCH
}

enum RedemptionStatus {
  HELD
  APPLIED
  RELEASED
  REFUNDED
}

enum DiscountSource {
  CUSTOMER_COUPON
  AUTOMATIC
  STAFF_OVERRIDE
}



enum LoyaltyFormulaMode {
  SPEND_RATIO
  PERCENTAGE
  FIXED_AMOUNT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum CoinLedgerAction {
  BOOKING_EARN
  REFERRAL_BONUS
  SIGNUP_BONUS
  BIRTHDAY_BONUS
  STREAK_BONUS
  HOLD_PLACED
  HOLD_RELEASED
  HOLD_BURNED
  EXPIRY
  ADMIN_ADJUSTMENT
  REFUND_CLAWBACK
  REDEMPTION_REVERSAL
}

enum HoldStatus {
  ACTIVE
  BURNED
  RELEASED
}

enum RefundStatus {
  PENDING
  INFO_REQUESTED
  APPROVED
  REJECTED
  PROCESSED
  FAILED
  PROCESSING
  REQUIRES_RECONCILIATION
}

enum RefundReasonCode {
  FACILITY_ISSUE
  SERVICE_FAILURE
  DUPLICATE_PAYMENT
  UNAVAILABLE_RESOURCE
  CUSTOMER_DISPUTE
  PRICE_CHANGED
  OTHER
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  passwordHash       String?
  firstName          String
  lastName           String
  phoneNumber        String?
  avatarUrl          String?
  birthday           String?              // Stored as "MM-DD" (e.g. "05-24" for May 24th, year excluded)
  clientId           String               @unique
  role               UserRole             @default(CUSTOMER)
  isVerified         Boolean              @default(false)
  onboardingCompleted Boolean             @default(true)
  acquisitionSource  String?
  mfaEnabled         Boolean              @default(false)
  mfaMethod          MfaMethod?           // null until configured
  mfaSecret          String?              // AES-256-GCM encrypted TOTP secret
  skipAnonymization  Boolean              @default(false)
  deactivatedAt      DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  referralCode       String?              @unique
  referredById       String?
  referredBy         User?                @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers      User[]               @relation("UserReferrals")

  identities         AuthIdentity[]
  bookings           Booking[]
  transactions       Transaction[]
  invoices           Invoice[]
  consents           PolicyConsent[]
  sessions           AuthSession[]
  verificationTokens VerificationToken[]
  resetTokens        PasswordResetToken[]
  mfaOtpTokens       MfaOtpToken[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  visitSessions      VisitSession[]
  customerDiscountRedemptions DiscountRedemption[]    @relation("CustomerDiscountRedemptions")
  staffDiscountRedemptions    DiscountRedemption[]    @relation("StaffDiscountRedemptions")
  targetedDiscounts           DiscountTargetCustomer[]

  referralRewardsGiven        ReferralRewardLog[]     @relation("ReferrerRewards")
  referralRewardsReceived     ReferralRewardLog[]     @relation("RefereeRewards")
  reviews                     Review[]
  coinBalance                 CoinBalance?
  coinLedgerEntries           CoinLedgerEntry[]
  coinHolds                   CoinHold[]
  refundRequestsRaised        RefundRequest[]         @relation("RefundRequestedBy")
  refundRequestsReviewed      RefundRequest[]         @relation("RefundReviewedBy")
  refundReferralsClawedBack   RefundRequest[]         @relation("RefundReferrer")
  campaignsCreated            Campaign[]              @relation("CampaignCreatedBy")
  campaignsAiApproved         Campaign[]              @relation("CampaignAiApprovedBy")
  campaignExecutions          CampaignExecution[]     @relation("CampaignRecipient")

  @@index([role])
  @@index([role, isVerified])
  @@index([createdAt])
  @@index([referredById])
  @@index([referredById, createdAt])
  @@index([referralCode])
  @@index([deactivatedAt])
  @@map("users")
}

model AuthIdentity {
  id             String   @id @default(uuid())
  userId         String
  provider       String   // "GOOGLE" | "PASSWORD"
  providerUserId String   // Google's stable `sub` claim — NOT email
  email          String   // email at time of linking, for audit
  linkedAt       DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model PolicyConsent {
  id            String         @id @default(uuid())
  userId        String
  policyVersion String
  purpose       String
  consentedAt   DateTime       @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("policy_consents")
}

model AuthSession {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  tokenFamily      String
  ipAddress         String?
  userAgent         String?
  deviceFingerprint String?
  mismatchCount     Int      @default(0)
  isRevoked         Boolean  @default(false)
  expiresAt         DateTime
  lastUsedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
  @@map("auth_sessions")
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model MfaOtpToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique  // SHA-256 of the 6-digit OTP code
  expiresAt DateTime            // now + 10 minutes
  usedAt    DateTime?           // set on consumption to prevent replay
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_otp_tokens")
}

model ClientIdSequence {
  year         Int      @id
  nextSequence Int      @default(1)
  updatedAt    DateTime @updatedAt

  @@map("client_id_sequences")
}

model InvoiceSequence {
  year         Int      @id
  nextSequence Int      @default(1)
  updatedAt    DateTime @updatedAt

  @@map("invoice_sequences")
}

model OutboxEvent {
  id            String       @id @default(uuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0)
  attempts      Int          @default(0)
  error         String?
  lastError     String?
  workerId      String?
  lockedAt      DateTime?
  scheduledAt   DateTime     @default(now())
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, scheduledAt])
  @@index([status, lockedAt])
  @@map("outbox_events")
}

model Notification {
  id            String    @id @default(uuid())
  userId        String
  type          String
  title         String
  message       String
  linkHref      String?
  metadata      Json?
  sourceEventId String?   @unique
  readAt        DateTime?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, archivedAt, createdAt])
  @@map("notifications")
}

model FacilityResource {
  id            String           @id @default(uuid())
  name          String
  slug          String           @unique
  category      ResourceCategory
  description   String
  capacity      Int              @default(1)
  location      String
  amenities     String[]
  imageUrl      String?
  sortOrder     Int              @default(0)
  isPopular     Boolean          @default(false)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  pricing       ResourcePricing[]
  schedules     ResourceSchedule[]
  blackouts     ResourceBlackout[]
  bookings      Booking[]
  targetedDiscounts DiscountTargetResource[]
  reviews       Review[]

  @@map("facility_resources")
}

model ResourcePricing {
  id              String           @id @default(uuid())
  resourceId      String
  planName        String
  durationHours   Int?
  durationDays    Int?
  durationMonths  Int?
  price           Decimal          @db.Decimal(12, 2)
  currency        String           @default("NGN")
  isPopular       Boolean          @default(false)
  isActive        Boolean          @default(true)
  isNightPlan     Boolean          @default(false)
  operatingHours  String?
  effectiveFrom   DateTime         @default(now())
  effectiveTo     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  resource        FacilityResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("resource_pricing")
}

model ResourceSchedule {
  id          String           @id @default(uuid())
  resourceId  String
  dayOfWeek   Int              // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  openTime    String           @default("08:00")
  closeTime   String           @default("20:00")
  is24Hours   Boolean          @default(false)
  isClosed    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  resource    FacilityResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, dayOfWeek])
  @@map("resource_schedules")
}

model ResourceBlackout {
  id              String           @id @default(uuid())
  resourceId      String
  startDate       DateTime
  endDate         DateTime
  reason          String
  isActive        Boolean          @default(true)
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  resource        FacilityResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, startDate, endDate])
  @@map("resource_blackouts")
}

model Booking {
  id              String           @id @default(uuid())
  reference       String           @unique
  resourceId      String
  userId          String
  startTime       DateTime
  endTime         DateTime
  state           BookingState     @default(DRAFT)
  holdExpiresAt   DateTime?
  quantity        Int              @default(1)
  totalAmount     Decimal          @db.Decimal(12, 2)
  cashDue         Decimal          @db.Decimal(12, 2) @default(0)
  coinsRedeemed   Decimal          @db.Decimal(18, 4) @default(0)
  coinTenderAmount Decimal         @db.Decimal(12, 2) @default(0)
  conversionRateSnapshot Decimal?  @db.Decimal(12, 4)
  originalAmount  Decimal?         @db.Decimal(12, 2)
  discountAmount  Decimal?         @db.Decimal(12, 2) @default(0)
  discountId      String?
  discountCode    String?
  redeemedCoins   Decimal?         @db.Decimal(12, 2) @default(0)
  redeemedCoinsNgn Decimal?        @db.Decimal(12, 2) @default(0)
  coinHoldReleased Boolean?        @default(false)
  currency        String           @default("NGN")
  qrToken         String?
  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  resource        FacilityResource @relation(fields: [resourceId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  discount        Discount?        @relation(fields: [discountId], references: [id], onDelete: SetNull)
  transactions    Transaction[]
  visitSessions   VisitSession[]
  redemptions     DiscountRedemption[]
  review          Review?
  coinHold        CoinHold?
  refundRequests  RefundRequest[]

  @@index([resourceId, startTime, endTime])
  @@index([state])
  @@index([userId])
  @@index([userId, state])
  @@index([createdAt])
  @@index([holdExpiresAt, state])
  @@index([checkedInAt])
  @@map("bookings")
}

model Transaction {
  id                String         @id @default(uuid())
  reference         String         @unique
  bookingId         String
  userId            String
  amount            Decimal        @db.Decimal(12, 2)
  currency          String         @default("NGN")
  status            PaymentStatus  @default(PENDING)
  method            PaymentMethod  @default(PAYSTACK)
  paystackReference String?        @unique
  paystackChannel   String?
  gatewayResponse   Json?
  webhookEventId    String?        @unique
  webhookReceivedAt DateTime?
  paidAt            DateTime?
  failedAt          DateTime?
  refundedAt        DateTime?
  refundAmount      Decimal?       @db.Decimal(12, 2)
  refundReason      String?
  refundedBy        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  booking           Booking        @relation(fields: [bookingId], references: [id])
  user              User           @relation(fields: [userId], references: [id])
  invoice           Invoice?
  refundRequest     RefundRequest?

  @@index([status])
  @@index([bookingId])
  @@index([webhookEventId])
  @@index([userId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("transactions")
}

model Invoice {
  id               String      @id @default(uuid())
  invoiceNumber    String      @unique
  transactionId    String      @unique
  bookingId        String
  userId           String
  subtotal         Decimal     @db.Decimal(12, 2)
  tax              Decimal     @db.Decimal(12, 2) @default(0)
  total            Decimal     @db.Decimal(12, 2)
  currency         String      @default("NGN")
  lineItems        Json
  issuedAt         DateTime    @default(now())
  customerName     String
  customerEmail    String
  customerClientId String
  resourceName     String
  bookingReference String
  createdAt        DateTime    @default(now())

  transaction      Transaction @relation(fields: [transactionId], references: [id])
  user             User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([bookingId])
  @@map("invoices")
}

model AuditLog {
  id          String         @id @default(uuid())
  userId      String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime       @default(now())

  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model VisitSession {
  id           String    @id @default(uuid())
  bookingId    String
  userId       String
  staffUserId  String?
  terminalId   String?   @default("REC-GATE-01")
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  ipAddress    String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([userId])
  @@index([checkInTime])
  @@map("visit_sessions")
}

model EmailTemplate {
  id           String   @id @default(uuid())
  type         String   @unique
  subject      String
  htmlBody     String
  textBody     String?
  isActive     Boolean  @default(true)
  lastEditedBy String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("email_templates")
}

model Discount {
  id                 String               @id @default(uuid())
  code               String?              @unique
  name               String
  description        String?
  type               DiscountType
  value              Decimal              @db.Decimal(12, 2)
  maxDiscountAmount  Decimal?             @db.Decimal(12, 2)
  minOrderAmount     Decimal?             @db.Decimal(12, 2) @default(0)
  currency           String               @default("NGN")
  isAutomatic        Boolean              @default(false)
  isActive           Boolean              @default(true)
  validFrom          DateTime             @default(now())
  validUntil         DateTime?
  maxUsageTotal      Int?
  maxUsagePerUser    Int                  @default(1)
  currentUsageCount  Int                  @default(0)
  appliesToAll       Boolean              @default(true)
  targetCategories   ResourceCategory[]
  customerEligibility CustomerEligibility @default(ALL)
  targetEmailDomains String[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  targetResources    DiscountTargetResource[]
  targetCustomers    DiscountTargetCustomer[]
  redemptions        DiscountRedemption[]
  bookings           Booking[]

  @@index([code])
  @@index([isActive, validFrom, validUntil])
  @@map("discounts")
}

model DiscountTargetResource {
  id         String           @id @default(uuid())
  discountId String
  resourceId String

  discount   Discount         @relation(fields: [discountId], references: [id], onDelete: Cascade)
  resource   FacilityResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([discountId, resourceId])
  @@map("discount_target_resources")
}

model DiscountTargetCustomer {
  id         String           @id @default(uuid())
  discountId String
  userId     String

  discount   Discount         @relation(fields: [discountId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discountId, userId])
  @@map("discount_target_customers")
}

model DiscountRedemption {
  id                String           @id @default(uuid())
  discountId        String?
  userId            String
  bookingId         String
  transactionId     String?
  source            DiscountSource   @default(CUSTOMER_COUPON)
  appliedByStaffId  String?
  justificationNote String?
  originalAmount    Decimal          @db.Decimal(12, 2)
  discountAmount    Decimal          @db.Decimal(12, 2)
  finalAmount       Decimal          @db.Decimal(12, 2)
  status            RedemptionStatus @default(HELD)
  heldAt            DateTime         @default(now())
  appliedAt         DateTime?
  releasedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  discount          Discount?        @relation(fields: [discountId], references: [id], onDelete: SetNull)
  user              User             @relation("CustomerDiscountRedemptions", fields: [userId], references: [id], onDelete: Cascade)
  appliedByStaff    User?            @relation("StaffDiscountRedemptions", fields: [appliedByStaffId], references: [id], onDelete: SetNull)
  booking           Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([discountId])
  @@index([userId])
  @@index([bookingId])
  @@index([appliedByStaffId])
  @@index([source])
  @@map("discount_redemptions")
}

model LegalPolicy {
  id            String    @id @db.VarChar(64)
  type          String    @unique @db.VarChar(64)
  title         String    @db.Text
  content       String    @db.Text
  version       String    @default("1.0") @db.VarChar(32)
  effectiveDate DateTime  @default(now()) @map("effective_date") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy     String?   @map("updated_by") @db.VarChar(64)

  @@map("legal_policies")
}

model SupportSetting {
  id        String   @id @default("default") @db.VarChar(64)
  contact   Json     @db.JsonB
  faqs      Json     @db.JsonB
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.VarChar(64)

  @@map("support_settings")
}



model ReferralRewardLog {
  id              String   @id @default(uuid())
  referrerId      String
  refereeId       String   @unique
  bookingId       String
  coinsAwarded    Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  referrer        User     @relation("ReferrerRewards", fields: [referrerId], references: [id], onDelete: Cascade)
  referee         User     @relation("RefereeRewards", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([bookingId])
  @@index([createdAt])
  @@map("referral_reward_logs")
}

model LoyaltySetting {
  id                         String             @id @default("default") @db.VarChar(64)
  isProgramActive            Boolean            @default(true)
  coinName                   String             @default("PeeDee Coin")
  coinSymbol                 String             @default("PD")
  isTransactionRewardEnabled Boolean            @default(true)
  formulaMode                LoyaltyFormulaMode @default(SPEND_RATIO)
  spendRatioNgn              Decimal            @db.Decimal(12, 2) @default(200.00)
  percentageRate             Decimal            @db.Decimal(5, 2)  @default(0.50)
  fixedAmountCoins           Decimal            @db.Decimal(12, 2) @default(50.00)
  minSpendThreshold          Decimal            @db.Decimal(12, 2) @default(500.00)
  maxCoinsPerTransaction     Decimal?           @db.Decimal(12, 2)
  isReferralRewardEnabled    Boolean            @default(true)
  coinsPerActiveReferral     Decimal            @db.Decimal(12, 2) @default(0.00)
  refereeWelcomeBonus        Decimal            @db.Decimal(12, 2) @default(200.00)
  isRedemptionEnabled        Boolean            @default(true)
  redemptionRateCoins        Decimal            @db.Decimal(12, 2) @default(100.00)
  redemptionRateNgn          Decimal            @db.Decimal(12, 2) @default(100.00)
  minCoinsToRedeem           Decimal            @db.Decimal(12, 2) @default(100.00)
  maxDiscountPercent         Decimal            @db.Decimal(5, 2)  @default(50.00)
  
  // Extended Milestones, Streaks, Lifecycle & Risk Policies
  isBirthdayBonusEnabled     Boolean            @default(true)
  birthdayBonusCoins         Decimal            @db.Decimal(12, 2) @default(50.00)
  isStreakBonusEnabled       Boolean            @default(true)
  streakBonusCoins           Decimal            @db.Decimal(12, 2) @default(30.00)
  streakThresholdCount       Int                @default(4)
  streakWindowDays           Int                @default(30)
  isSignupBonusEnabled       Boolean            @default(true)
  signupBonusCoins           Decimal            @db.Decimal(12, 2) @default(20.00)
  isExpiryEnabled            Boolean            @default(true)
  expiryMonths               Int                @default(12)
  referralRewardPercent      Decimal            @db.Decimal(5, 2)  @default(5.00)
  referralFloorCoins         Decimal            @db.Decimal(12, 2) @default(50.00)
  referralCapCoins           Decimal            @db.Decimal(12, 2) @default(1000.00)
  referralWindowDays         Int                @default(90)
  dailyAdjustmentLimitCoins  Decimal            @db.Decimal(12, 2) @default(20000.00)
  holdExpiryMinutes          Int                @default(15)

  updatedAt                  DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy                  String?            @map("updated_by") @db.VarChar(64)

  @@map("loyalty_settings")
}

model Review {
  id              String           @id @default(uuid())
  userId          String
  bookingId       String           @unique
  resourceId      String
  
  rating          Int
  powerRating     Int?
  wifiRating      Int?
  comfortRating   Int?
  staffRating     Int?

  title           String?
  comment         String           @db.Text
  
  status          ReviewStatus     @default(APPROVED)
  isFeaturedOnHome Boolean         @default(false)

  adminReply      String?          @db.Text
  adminRepliedAt  DateTime?
  adminRepliedBy  String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking         Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource        FacilityResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([status, isFeaturedOnHome])
  @@index([resourceId, status])
  @@index([userId])
  @@map("reviews")
}

model ReviewSetting {
  id                         String   @id @default("default") @db.VarChar(64)
  requireApproval            Boolean  @default(true)
  isHomepageSpotlightEnabled Boolean  @default(true)
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy                  String?  @map("updated_by") @db.VarChar(64)

  @@map("review_settings")
}

model CoinBalance {
  userId         String    @id
  balance        Decimal   @db.Decimal(12, 4) @default(0)
  lifetimeEarned Decimal   @db.Decimal(12, 4) @default(0)
  lifetimeBurned Decimal   @db.Decimal(12, 4) @default(0)
  lastEarnedAt   DateTime?
  version        Int       @default(0)
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([balance])
  @@index([lifetimeEarned])
  @@map("coin_balances")
}

model CoinLedgerEntry {
  id             String           @id @default(uuid())
  userId         String
  action         CoinLedgerAction
  amount         Decimal          @db.Decimal(12, 4)
  balanceAfter   Decimal          @db.Decimal(12, 4)
  referenceType  String
  referenceId    String?
  idempotencyKey String           @unique
  metadata       Json?
  createdAt      DateTime         @default(now())

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([referenceId, action])
  @@index([userId, action, createdAt])
  @@map("coin_ledger_entries")
}

model CoinHold {
  id         String     @id @default(uuid())
  userId     String
  bookingId  String     @unique
  amount     Decimal    @db.Decimal(12, 4)
  nairaValue Decimal    @db.Decimal(12, 2)
  status     HoldStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("coin_holds")
}

model RefundRequest {
  id                      String           @id @default(uuid())
  bookingId               String?
  transactionId           String?          @unique
  amount                  Decimal          @db.Decimal(12, 2)
  coinsToReverse          Decimal          @db.Decimal(12, 4) @default(0)
  coinsToClawback         Decimal          @db.Decimal(12, 4) @default(0)
  referralCoinsToClawback Decimal          @db.Decimal(12, 4) @default(0)
  referrerId              String?
  reasonCode              RefundReasonCode
  reason                  String           @db.Text
  status                  RefundStatus     @default(PENDING)
  isSystemInitiated       Boolean          @default(false)
  requestedByUserId       String?
  requestedAt             DateTime         @default(now())
  reviewedByUserId        String?
  reviewedAt              DateTime?
  rejectionReason         String?
  infoRequested           String?          @db.Text
  infoProvided            String?          @db.Text
  paystackRefundId        String?
  gatewayReference        String?
  failureReason           String?
  workerId                String?
  claimedAt               DateTime?
  gatewayRequestedAt      DateTime?
  attempts                Int              @default(0)
  lastError               String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  booking                 Booking?         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transaction             Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  requestedBy             User?            @relation("RefundRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedBy              User?            @relation("RefundReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  referrer                User?            @relation("RefundReferrer", fields: [referrerId], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
  @@index([bookingId])
  @@index([transactionId])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
  @@map("refund_requests")
}

enum CampaignType {
  WELCOME_SERIES
  INACTIVE_30D
  BIRTHDAY
  STREAK_ACHIEVEMENT
  ABANDONED_BOOKING
  MILESTONE_TIER
  CUSTOM_BROADCAST
}

enum CampaignTriggerType {
  EVENT
  SCHEDULED_CRON
  MANUAL
}

enum CampaignChannel {
  EMAIL
  IN_APP
  BOTH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum CampaignExecutionStatus {
  SENT
  DELIVERED
  FAILED
  DEFERRED_QUIET_HOURS
  SUPPRESSED_FREQUENCY_CAP
  SUPPRESSED_BUDGET_CAP
  SUPPRESSED_HOLDOUT
}

model Campaign {
  id                 String               @id @default(uuid())
  name               String
  description        String?
  type               CampaignType
  triggerType        CampaignTriggerType  @default(SCHEDULED_CRON)
  channel            CampaignChannel      @default(EMAIL)
  status             CampaignStatus       @default(DRAFT)
  subject            String?
  body               String               @db.Text
  coinReward         Decimal?             @db.Decimal(12, 4)
  discountPercentage Decimal?             @db.Decimal(5, 2)
  isDiscretionary    Boolean              @default(true) // Discretionary marketing subject to 7d frequency cap and 10% holdout
  frequencyCapDays   Int                  @default(7)
  budgetLimitNgn     Decimal?             @db.Decimal(12, 2)
  spentBudgetNgn     Decimal              @db.Decimal(12, 2) @default(0)
  holdoutPercentage  Int                  @default(10)
  aiGenerated        Boolean              @default(false)
  aiPrompt           String?              @db.Text
  aiApprovedByUserId String?
  aiApprovedAt       DateTime?
  audienceFilter     Json?
  scheduledAt        DateTime?
  lastRunAt          DateTime?
  createdByUserId    String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  aiApprovedBy       User?                @relation("CampaignAiApprovedBy", fields: [aiApprovedByUserId], references: [id], onDelete: SetNull)
  createdBy          User?                @relation("CampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  executions         CampaignExecution[]
  metrics            CampaignMetric[]

  @@index([status, triggerType])
  @@index([type])
  @@map("campaigns")
}

model CampaignExecution {
  id                 String                  @id @default(uuid())
  campaignId         String
  recipientUserId    String
  channel            CampaignChannel         @default(EMAIL)
  status             CampaignExecutionStatus @default(SENT)
  isHoldout          Boolean                 @default(false)
  deferredUntil      DateTime?
  coinAwarded        Decimal?                @db.Decimal(12, 4)
  sentAt             DateTime?
  convertedAt        DateTime?
  conversionAmount   Decimal?                @db.Decimal(12, 2)
  metadata           Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  campaign           Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient          User                    @relation("CampaignRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt])
  @@index([campaignId, status])
  @@index([status, deferredUntil])
  @@map("campaign_executions")
}

model CampaignMetric {
  id                   String   @id @default(uuid())
  campaignId           String
  period               String
  totalTargeted        Int      @default(0)
  treatmentSent        Int      @default(0)
  holdoutCount         Int      @default(0)
  treatmentConversions Int      @default(0)
  holdoutConversions   Int      @default(0)
  treatmentRevenue     Decimal  @db.Decimal(12, 2) @default(0)
  holdoutRevenue       Decimal  @db.Decimal(12, 2) @default(0)
  incrementalLift      Decimal  @db.Decimal(8, 4) @default(0)
  updatedAt            DateTime @updatedAt

  campaign             Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, period])
  @@map("campaign_metrics")
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

model WebhookEvent {
  id             String             @id @default(uuid())
  eventId        String             @unique
  eventType      String
  payload        Json
  status         WebhookEventStatus @default(PENDING)
  leaseHolder    String?
  workerId       String?
  leasedAt       DateTime?
  lockedAt       DateTime?
  leaseExpiresAt DateTime?
  nextAttemptAt  DateTime?
  processedAt    DateTime?
  error          String?
  lastError      String?
  retryCount     Int                @default(0)
  attempts       Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, leaseExpiresAt])
  @@index([status, nextAttemptAt])
  @@index([eventId])
  @@map("webhook_events")
}

