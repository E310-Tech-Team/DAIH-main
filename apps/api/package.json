{
  "name": "@daih/api",
  "version": "1.0.0",
  "private": true,
  "description": "DAIH Workspace Platform - Express Modular Monolith API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm --filter @daih/types build",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "tsx watch src/jobs/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate --schema=src/db/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=src/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/db/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=src/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema=src/db/prisma/schema.prisma",
    "seed:admin": "tsx src/scripts/seed-super-admin.ts",
    "create:admin": "tsx src/scripts/create-admin.ts",
    "seed:templates": "tsx src/db/seeds/email-templates.seed.ts",
    "seed:loyalty": "tsx src/db/seeds/loyalty-settings.seed.ts",
    "ledger:reconcile": "tsx src/scripts/reconcile-ledger.ts",
    "policy:sanitize": "tsx src/scripts/sanitize-policies.ts"
  },
  "dependencies": {
    "@daih/types": "workspace:*",
    "@prisma/adapter-pg": "^6.4.1",
    "@prisma/client": "^6.4.1",
    "@sentry/node": "^8.55.0",
    "@sentry/profiling-node": "^8.55.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.41.6",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dd-trace": "^5.37.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.0",
    "resend": "^4.1.2",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@daih/config": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "openapi-types": "^12.1.3",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
