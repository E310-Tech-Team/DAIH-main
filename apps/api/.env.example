# ==============================================================================
# DAIH Backend API Service - Hostinger VPS Production Template (.env.example)
# ==============================================================================

# Server & Runtime
NODE_ENV=production
PORT=4000

# ─── PostgreSQL Database Connection ──────────────────────────────────────────
DATABASE_URL="postgresql://postgres:YOUR_SECURE_DB_PASSWORD@localhost:5432/daih_db?schema=public"

# ─── Redis Cache & Rate Limiting ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Security & Authentication (JWT & Encryption) ────────────────────────────
# CRITICAL FOR PRODUCTION: Must be at least 32 characters and completely independent
# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-openssl-rand-hex-32-secret-one"
JWT_REFRESH_SECRET="replace-with-openssl-rand-hex-32-secret-two"
TOKEN_ENCRYPTION_KEY="replace-with-openssl-rand-hex-32-secret-three"
QR_SIGNING_SECRET="replace-with-openssl-rand-hex-32-qr-secret"

# Token Expiry Durations
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_REFRESH_DAYS=7
VERIFICATION_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_HOURS=1

# ─── Cookies & Subdomain Scoping ────────────────────────────────────────────
# Set to ".daih.ng" on Hostinger VPS to allow first-party refresh token sharing across subdomains
COOKIE_DOMAIN=".daih.ng"
COOKIE_PATH="/api/v1/identity"
COOKIE_SAME_SITE="lax"
COOKIE_SECURE="true"

# ─── Reverse Proxy IP Trust & Origin Security (Hostinger Nginx) ──────────────
# Trusts loopback (127.0.0.1/::1) from local Nginx and Docker bridge subnets
TRUSTED_PROXIES="loopback,linklocal,uniquelocal"

# Optional shared secret verified between Nginx and Express for defense-in-depth:
# In Nginx: proxy_set_header X-Origin-Verify-Secret "your-origin-verify-secret";
ORIGIN_VERIFY_SECRET="replace-with-origin-secret-shared-with-nginx"

# Leave false in production; set to true only when verifying IP resolution as Super Admin
ENABLE_DIAGNOSTIC_IP_ENDPOINT="false"

# ─── Initial Super Administrator Seeding (pnpm run seed:admin) ───────────────
SUPER_ADMIN_EMAIL="admin@daih.ng"
SUPER_ADMIN_PASSWORD="ReplaceWithStrongAdminPassword123!"
SUPER_ADMIN_FIRST_NAME="Super"
SUPER_ADMIN_LAST_NAME="Administrator"
SUPER_ADMIN_PHONE="07042504389"

# ─── Transactional Email Providers ───────────────────────────────────────────
EMAIL_PROVIDER="auto" # Options: 'auto' | 'resend' | 'zeptomail' | 'mock'
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="DAIH Hub <noreply@daih.ng>"
ZEPTOMAIL_API_KEY=""
ZEPTOMAIL_FROM_EMAIL="DAIH Hub <noreply@daih.ng>"
ZEPTOMAIL_API_URL="https://api.zeptomail.com/v1.1/email"

# ─── Rate Limiting (Redis-backed) ────────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=15
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW=60
RATE_LIMIT_VERIFY_MAX=3
RATE_LIMIT_VERIFY_WINDOW=60
RATE_LIMIT_RESET_MAX=3
RATE_LIMIT_RESET_WINDOW=60

# ─── Frontend Service URLs & CORS ────────────────────────────────────────────
FRONTEND_CUSTOMER_URL="https://app.daih.ng"
FRONTEND_ADMIN_URL="https://admin.daih.ng"
FRONTEND_WEB_URL="https://daih.ng"
ALLOWED_ORIGINS="https://daih.ng,https://app.daih.ng,https://admin.daih.ng,https://reception.daih.ng"

# ─── Paystack Payment Gateway ────────────────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_live_xxx"
PAYSTACK_PUBLIC_KEY="pk_live_xxx"
# Paystack signs webhooks with PAYSTACK_SECRET_KEY; there is no separate webhook secret.
# Payments and webhooks stay disabled in production until the secret key is real.

# ─── File Storage (S3 / MinIO - Optional) ────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="daih-documents"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# ─── Observability (Sentry & Datadog) ────────────────────────────────────────
SENTRY_DSN=""
DD_SERVICE="daih-api"
DD_ENV="production"
DD_VERSION="1.0.0"
